# Copy to the repository root as `.env` before running `docker compose up`.
# These are required for the deployed stack; never commit real secrets.

# Public URL users open (used for links, CORS and email).
APP_URL=http://localhost:8080
WEB_PORT=8080

POSTGRES_DB=alumniconnect
POSTGRES_USER=alumniconnect
# Replace with a long random value, e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=change-me-postgres

# Replace with a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-jwt

# Optional: real SMTP relay. Leave empty to keep rich-preview mode.
SMTP_URL=
# SMTP_FROM="AlumniConnect <no-reply@your-domain>"

# Optional: Slack-compatible webhook for error-rate and latency alerts.
ALERT_WEBHOOK_URL=

# Web Push: generate once with `npx web-push generate-vapid-keys`.
# Leave empty to disable device notifications without affecting in-app ones.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@your-domain

# Upload malware scanning (optional). Run `docker compose --profile scan up`.
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# UPLOAD_SCAN_REQUIRED=false

# External tracing (optional): any OTLP/HTTP collector, e.g. Jaeger, Tempo.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=alumniconnect-api

# Scheduled backups (Postgres container loop).
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
