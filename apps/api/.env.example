# Copy to .env and adjust for your machine.
DATABASE_URL="file:./dev.db"
PORT=4000
WEB_ORIGIN="http://localhost:5173"
WEB_ORIGINS="http://localhost:5173"
JWT_SECRET="dev-secret-change-me-in-production"
APP_URL="http://localhost:5173"
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
# Development-only SMTP sink. When SMTP_URL/SMTP_HOST are unset, the API
# listens on this port and captures auth mail at GET /api/dev/mailbox
# (loopback only). Set DEV_MAILBOX=false to disable.
DEV_MAILBOX="true"
DEV_SMTP_PORT=1025
# ADMIN_MFA_REQUIRED="false"
# Meshy is used server-side for administrator-approved 3D environment assets.
# Never expose this value in VITE_* variables or Metaverse static files.
# MESHY_API_KEY="replace-with-a-rotated-key"
