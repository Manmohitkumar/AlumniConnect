// AlumniConnect data model.
// SQLite locally; provider-agnostic so the datasource can move to PostgreSQL.
// Status/role columns are strings because SQLite has no enums — the allowed
// values are documented next to each field and validated by zod at the API edge.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String?
  name               String
  // STUDENT | ALUMNI | UNIVERSITY | COMPANY | ADMIN
  role               String    @default("STUDENT")
  // ACTIVE | SUSPENDED
  status             String    @default("ACTIVE")
  emailVerified      Boolean   @default(false)
  // Provisioned accounts (university / company / admin) must replace the
  // one-time password before using the rest of the platform.
  mustChangePassword Boolean   @default(false)
  // Incremented on password change/reset so every existing session is revoked.
  tokenVersion       Int       @default(0)
  // TOTP-based administrator MFA (pending/required + enabled state).
  totpSecret         String?
  totpEnabled        Boolean   @default(false)
  headline           String?
  bio                String?
  location           String?
  avatarUrl          String?
  // JSON string: { mentorship: boolean, challenges: boolean, events: boolean, marketing: boolean }
  notificationPrefs  String?
  lastActiveAt       DateTime?
  // UI language + IANA time zone (Phase 10). Null means "use browser default".
  locale             String?
  timeZone           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  studentProfile    StudentProfile?
  alumniProfile     AlumniProfile?
  universityProfile UniversityProfile?
  authTokens        AuthToken[]

  challenges              Challenge[]            @relation("ChallengeAuthor")
  challengeParticipations ChallengeParticipant[]
  submissions             Submission[]           @relation("StudentSubmissions")
  evaluatedSubmissions    Submission[]           @relation("SubmissionEvaluator")
  evaluations             Evaluation[]
  certificates            Certificate[]          @relation("UserCertificates")
  issuedCertificates      Certificate[]          @relation("IssuedCertificates")
  mentorshipAsStudent     MentorshipRequest[]    @relation("MentorshipStudent")
  mentorshipAsMentor      MentorshipRequest[]    @relation("MentorshipMentor")
  notifications           Notification[]
  pushSubscriptions       PushSubscription[]
  hostedEvents            Event[]                @relation("HostedEvents")
  eventRegistrations      EventRegistration[]
  resources               KnowledgeResource[]    @relation("AuthoredResources")
  bookmarks               Bookmark[]
  opportunities           Opportunity[]          @relation("CompanyOpportunities")
  applications            Application[]
  portfolioProjects       PortfolioProject[]
  auditLogs               AuditLog[]
  roomVisits              RoomVisit[]
  feedback                Feedback[]
  createdApiKeys          ApiKey[]               @relation("CreatedApiKeys")
  dataRequests            DataRequest[]          @relation("UserDataRequests")
  hostedRooms             MetaverseRoom[]        @relation("HostedMetaverseRooms")
  roomPresence            RoomPresence[]         @relation("UserRoomPresence")
  consents                Consent[]
  createdWebhooks         WebhookEndpoint[]      @relation("CreatedWebhooks")
  aiSettings              AlumniAiSettings?      @relation("AlumniAiSettings")
  aiKnowledge             AlumniAiKnowledge[]    @relation("AlumniAiKnowledge")
  aiStudentConversations  AlumniAiConversation[] @relation("AiStudentConversations")
  aiAlumniConversations   AlumniAiConversation[] @relation("AiAlumniConversations")

  @@index([role, status])
}

model StudentProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  universityId       String?
  universityName     String?
  registrationNumber String?
  department         String?
  course             String?
  currentYear        Int?
  semester           Int?
  graduationYear     Int?
  skills             String?
  careerInterests    String?
  country            String?
  // UNVERIFIED | PENDING | VERIFIED | REJECTED
  verificationStatus String    @default("UNVERIFIED")
  verifiedAt         DateTime?
  verifiedById       String?
  // Opt-in switches. Both default to false: no visibility without consent.
  portfolioVisible   Boolean   @default(false)
  visibleToCompanies Boolean   @default(false)
  consentAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  university University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  @@index([universityId, verificationStatus])
}

model AlumniProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  universityId       String?
  universityName     String?
  registrationNumber String?
  graduationYear     Int?
  company            String?
  designation        String?
  industry           String?
  location           String?
  expertise          String?
  mentorshipTopics   String?
  availability       String?
  timezone           String?
  country            String?
  // Comma-separated language names the mentor can mentor in.
  languages          String?
  yearsExperience    Int?
  // UNVERIFIED | PENDING | VERIFIED | REJECTED
  verificationStatus String    @default("UNVERIFIED")
  verifiedAt         DateTime?
  verifiedById       String?
  mentorshipOpen     Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  university University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  @@index([industry, mentorshipOpen])
  @@index([universityId, verificationStatus])
}

model University {
  id            String   @id @default(cuid())
  name          String   @unique
  shortName     String?
  domain        String?  @unique
  city          String?
  country       String?
  region        String?
  website       String?
  // Institution-level defaults (Phase 10). JSON arrays where noted.
  defaultLocale String   @default("en")
  languages     String?
  timeZone      String?
  verified      Boolean  @default(true)
  createdAt     DateTime @default(now())

  representatives UniversityProfile[]
  students        StudentProfile[]
  alumni          AlumniProfile[]
  events          Event[]
}

model UniversityProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  universityId String
  designation  String?
  department   String?
  // JSON array of permissions, e.g. ["VERIFY_STUDENTS","VERIFY_ALUMNI","ANNOUNCE","EVENTS","ANALYTICS"]
  permissions  String?
  verified     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  // EMAIL_VERIFY | PASSWORD_RESET
  type      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Skill {
  id         String           @id @default(cuid())
  name       String           @unique
  challenges ChallengeSkill[]
}

model Challenge {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  summary         String
  category        String
  objectives      String?
  deliverables    String
  requirements    String?
  durationDays    Int
  isPaid          Boolean   @default(false)
  maxParticipants Int?
  // OPEN | CLOSED | ARCHIVED
  status          String    @default("OPEN")
  publishedAt     DateTime  @default(now())
  deadline        DateTime?
  authorId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  author       User                   @relation("ChallengeAuthor", fields: [authorId], references: [id])
  skills       ChallengeSkill[]
  submissions  Submission[]
  certificates Certificate[]
  participants ChallengeParticipant[]

  @@index([status, publishedAt])
}

model ChallengeParticipant {
  challengeId String
  userId      String
  joinedAt    DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([challengeId, userId])
  @@index([userId, joinedAt])
}

model ChallengeSkill {
  challengeId String
  skillId     String

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([challengeId, skillId])
}

model Submission {
  id              String    @id @default(cuid())
  challengeId     String
  studentId       String
  title           String
  summary         String?
  repoUrl         String?
  demoUrl         String?
  fileUrl         String?
  // SUBMITTED | UNDER_REVIEW | EVALUATED | WITHDRAWN
  status          String    @default("SUBMITTED")
  score           Int?
  feedback        String?
  evaluatedById   String?
  evaluatedAt     DateTime?
  // AI draft feedback is advisory only. A human evaluator must approve it
  // through /api/ai/submissions/:id/evaluation-draft/approve before it is used.
  aiDraftFeedback String?
  aiDraftScore    Int?
  aiDraftAt       DateTime?
  aiAssisted      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  challenge   Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  student     User         @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  evaluatedBy User?        @relation("SubmissionEvaluator", fields: [evaluatedById], references: [id])
  evaluations Evaluation[]

  @@unique([challengeId, studentId])
  @@index([challengeId, status])
  @@index([studentId, status])
}

model Evaluation {
  id           String   @id @default(cuid())
  submissionId String
  evaluatorId  String
  score        Int
  feedback     String
  // JSON string with per-criterion scores, e.g. {"impact":8,"craft":9}
  criteria     String?
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  evaluator  User       @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
}

model MentorshipRequest {
  id          String    @id @default(cuid())
  studentId   String
  mentorId    String
  topic       String
  message     String
  // PENDING | ACCEPTED | DECLINED | COMPLETED | CANCELLED
  status      String    @default("PENDING")
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student  User                @relation("MentorshipStudent", fields: [studentId], references: [id], onDelete: Cascade)
  mentor   User                @relation("MentorshipMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  sessions MentorshipSession[]

  @@index([mentorId, status])
  @@index([studentId, status])
}

model MentorshipSession {
  id           String   @id @default(cuid())
  requestId    String
  scheduledAt  DateTime
  durationMins Int      @default(30)
  // SCHEDULED | COMPLETED | CANCELLED
  status       String   @default("SCHEDULED")
  roomKey      String?
  notes        String?
  rating       Int?
  feedback     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  request MentorshipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, scheduledAt])
  @@index([scheduledAt, status])
}

model Certificate {
  id          String    @id @default(cuid())
  code        String    @unique
  userId      String
  challengeId String?
  issuedById  String
  title       String
  // CHALLENGE_COMPLETION | CHALLENGE_WINNER | ALUMNI_APPRECIATION | PROJECT_RECOGNITION
  kind        String
  issuedAt    DateTime  @default(now())
  revokedAt   DateTime?

  user      User       @relation("UserCertificates", fields: [userId], references: [id], onDelete: Cascade)
  issuer    User       @relation("IssuedCertificates", fields: [issuedById], references: [id])
  challenge Challenge? @relation(fields: [challengeId], references: [id])

  @@index([userId, issuedAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// Browser Web Push endpoint for the installed PWA. One row per browser/profile.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  // Push service URL; unique so re-subscribing the same browser updates one row.
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Event {
  id            String    @id @default(cuid())
  title         String
  description   String
  category      String
  // ONLINE | CAMPUS | METAVERSE
  mode          String    @default("ONLINE")
  location      String?
  metaverseRoom String?
  // IANA zone of the host; viewers see local time plus this authoritative zone.
  timeZone      String?
  language      String?
  meetingUrl    String?
  recordingUrl  String?
  startsAt      DateTime
  endsAt        DateTime?
  capacity      Int?
  // PUBLISHED | CANCELLED | COMPLETED
  status        String    @default("PUBLISHED")
  hostId        String
  universityId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  host          User                @relation("HostedEvents", fields: [hostId], references: [id])
  university    University?         @relation(fields: [universityId], references: [id], onDelete: SetNull)
  registrations EventRegistration[]

  @@index([startsAt, status])
  @@index([universityId])
}

model EventRegistration {
  eventId        String
  userId         String
  registeredAt   DateTime  @default(now())
  attendedAt     DateTime?
  feedbackRating Int?
  feedbackText   String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId, registeredAt])
}

model KnowledgeResource {
  id        String   @id @default(cuid())
  title     String
  summary   String
  body      String
  category  String
  tags      String?
  // ARTICLE | VIDEO | GUIDE | TEMPLATE
  type      String   @default("ARTICLE")
  url       String?
  // PUBLISHED | DRAFT | REMOVED
  status    String   @default("PUBLISHED")
  views     Int      @default(0)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User       @relation("AuthoredResources", fields: [authorId], references: [id], onDelete: Cascade)
  bookmarks Bookmark[]

  @@index([status, category])
  @@index([authorId])
}

model Bookmark {
  userId     String
  resourceId String
  createdAt  DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource KnowledgeResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([userId, resourceId])
}

model Opportunity {
  id                String    @id @default(cuid())
  companyId         String
  title             String
  description       String
  // INTERNSHIP | JOB | MENTORSHIP_PROGRAM
  type              String    @default("INTERNSHIP")
  location          String?
  remote            Boolean   @default(false)
  country           String?
  region            String?
  language          String?
  skills            String?
  salaryCurrency    String?
  salaryMin         Int?
  salaryMax         Int?
  workAuthorization String?
  deadline          DateTime?
  // DRAFT | OPEN | CLOSED
  status            String    @default("OPEN")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company      User          @relation("CompanyOpportunities", fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([status, createdAt])
}

model Application {
  id            String   @id @default(cuid())
  opportunityId String
  studentId     String
  coverNote     String?
  // APPLIED | SHORTLISTED | REJECTED | WITHDRAWN
  status        String   @default("APPLIED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, studentId])
  @@index([studentId, status])
}

model PortfolioProject {
  id         String   @id @default(cuid())
  studentId  String
  title      String
  summary    String
  url        String?
  skills     String?
  // PRIVATE | PLATFORM | PUBLIC
  visibility String   @default("PLATFORM")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model RoomVisit {
  id              String    @id @default(cuid())
  userId          String
  roomKey         String
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?
  durationSeconds Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomKey, joinedAt])
  @@index([userId, joinedAt])
}

model MetaverseRoom {
  id           String    @id @default(cuid())
  name         String
  topic        String
  hostId       String
  universityId String?
  language     String    @default("en")
  scheduledAt  DateTime?
  // OPEN | LIVE | CLOSED
  status       String    @default("OPEN")
  createdAt    DateTime  @default(now())

  host     User           @relation("HostedMetaverseRooms", fields: [hostId], references: [id], onDelete: Cascade)
  presence RoomPresence[]

  @@index([status, createdAt])
}

model RoomPresence {
  id         String   @id @default(cuid())
  roomId     String
  userId     String
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())

  room MetaverseRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User          @relation("UserRoomPresence", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId, lastSeenAt])
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyPrefix   String
  // SHA-256 of the raw key. The raw value is shown once at creation time.
  keyHash     String    @unique
  scopes      String    @default("read")
  createdById String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  createdBy User @relation("CreatedApiKeys", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById, revokedAt])
}

model DataRequest {
  id        String   @id @default(cuid())
  userId    String
  // EXPORT | CORRECTION | DELETION
  type      String
  // OPEN | IN_REVIEW | COMPLETED | REJECTED
  status    String   @default("OPEN")
  note      String?
  response  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserDataRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      String?
  ip        String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([entity, entityId])
}

model Feedback {
  id         String    @id @default(cuid())
  userId     String
  // BUG | ACCOUNT | VERIFICATION | MENTORSHIP | CHALLENGE | PRIVACY | ACCESSIBILITY | OTHER
  category   String
  subject    String
  message    String
  // Route the report was filed from, e.g. /student/dashboard?tab=mentorship
  pagePath   String?
  // OPEN | IN_REVIEW | RESOLVED | CLOSED
  status     String    @default("OPEN")
  // LOW | NORMAL | HIGH
  priority   String    @default("NORMAL")
  adminNote  String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([category, status])
}

model Consent {
  id        String    @id @default(cuid())
  userId    String
  // AI_RECOMMENDATIONS | EXTERNAL_AI | PUBLIC_PORTFOLIO | RESEARCH_COLLAB | PARTNER_SHARING
  kind      String
  granted   Boolean   @default(false)
  grantedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([kind, granted])
}

model WebhookEndpoint {
  id          String   @id @default(cuid())
  name        String
  url         String
  // AES-256-GCM encrypted with the signing key; never returned by read APIs.
  secret      String
  // Comma-separated event names, or "*" for every supported event.
  events      String   @default("*")
  // ACTIVE | DISABLED
  status      String   @default("ACTIVE")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy  User              @relation("CreatedWebhooks", fields: [createdById], references: [id])
  deliveries WebhookDelivery[]

  @@index([status, createdAt])
}

model WebhookDelivery {
  id           String    @id @default(cuid())
  endpointId   String
  event        String
  payload      String
  signature    String
  // PENDING | DELIVERED | FAILED
  status       String    @default("PENDING")
  attempts     Int       @default(0)
  responseCode Int?
  error        String?
  createdAt    DateTime  @default(now())
  deliveredAt  DateTime?

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([status, createdAt])
}

model AlumniAiSettings {
  id                 String    @id @default(cuid())
  alumniId           String    @unique
  enabled            Boolean   @default(false)
  paused             Boolean   @default(false)
  // 1 = knowledge only, 2 = personalized mentorship. Level 3 is not offered.
  permissionLevel    Int       @default(1)
  useProfile         Boolean   @default(true)
  useExperience      Boolean   @default(true)
  useResources       Boolean   @default(true)
  useApprovedAnswers Boolean   @default(false)
  // Private messages are never ingested; kept explicit for the control panel.
  usePrivateMessages Boolean   @default(false)
  pausedAt           DateTime?
  disabledAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  alumni User @relation("AlumniAiSettings", fields: [alumniId], references: [id], onDelete: Cascade)
}

model AlumniAiKnowledge {
  id         String    @id @default(cuid())
  alumniId   String
  // PROFILE | EXPERIENCE | RESOURCE | APPROVED_ANSWER | FAQ | PROJECT
  type       String
  title      String
  content    String
  approved   Boolean   @default(false)
  approvedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  alumni User @relation("AlumniAiKnowledge", fields: [alumniId], references: [id], onDelete: Cascade)

  @@index([alumniId, approved, revokedAt])
}

model AlumniAiConversation {
  id        String   @id @default(cuid())
  studentId String
  alumniId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student  User              @relation("AiStudentConversations", fields: [studentId], references: [id], onDelete: Cascade)
  alumni   User              @relation("AiAlumniConversations", fields: [alumniId], references: [id], onDelete: Cascade)
  messages AlumniAiMessage[]

  @@unique([studentId, alumniId])
  @@index([alumniId, updatedAt])
}

model AlumniAiMessage {
  id               String    @id @default(cuid())
  conversationId   String
  // STUDENT | ASSISTANT
  role             String
  content          String
  // JSON array of { type, title } references used for the answer.
  sources          String?
  flagged          Boolean   @default(false)
  // OPEN | RESOLVED | DISMISSED. Null until an administrator reviews a flag.
  moderationStatus String?
  moderationNote   String?
  reviewedAt       DateTime?
  reviewedById     String?
  createdAt        DateTime  @default(now())

  conversation AlumniAiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Uploaded files. Storage key is server-generated; the client filename is
/// kept only for display. `visibility` is PUBLIC for avatars and PRIVATE for
/// submission attachments, which are served through an authorisation check.
model Upload {
  id           String   @id @default(cuid())
  ownerId      String
  key          String   @unique
  // avatar | submission | general
  kind         String   @default("general")
  // PUBLIC | PRIVATE
  visibility   String   @default("PRIVATE")
  mimeType     String
  bytes        Int
  sha256       String
  originalName String?
  createdAt    DateTime @default(now())

  @@index([ownerId, createdAt])
}
